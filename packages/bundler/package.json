{
  "name": "@asyncapi/bundler",
  "version": "1.1.0",
  "description": "Bundle references from a single AsyncAPI document into a single file.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "API.md",
    "LICENSE",
    "README.md",
    "/lib"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "get:version": "echo $npm_package_version",
    "get:name": "echo $npm_package_name",
    "prepublishOnly": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asyncapi/cli.git",
    "directory": "packages/bundler"
  },
  "keywords": [
    "asyncapi",
    "bundler"
  ],
  "author": "Souvik De <souvikde.ns@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/asyncapi/cli/issues"
  },
  "homepage": "https://github.com/asyncapi/cli/tree/master/packages/bundler#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.3.6",
    "@types/json-schema": "^7.0.11",
    "@ungap/structured-clone": "^1.2.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/jest": "^29.1.1",
    "@types/js-yaml": "^4.0.5",
    "@types/lodash": "^4.14.186",
    "@types/node": "^18.8.2",
    "@types/ungap__structured-clone": "^1.2.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^4.9.5"
  }
}
